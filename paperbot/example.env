# Mattermost personal access token for the bot user.
# Must have permission to read channels and post messages.
MATTERMOST_TOKEN=xxxxxxx

# Base HTTP(S) API endpoint of the Mattermost server.
# Prefixed by the protocol.
MATTERMOST_API_URL=https://chat.isocpp.org

# WebSocket endpoint used for real-time events (posts, reconnects, etc.).
# Typically MATTERMOST_API_URL + /api/v4/websocket
MATTERMOST_WEBSOCKER_URL=wss://chat.isocpp.org/api/v4/websocket

# URL to the WG21 paper/issue index consumed by PaperBot.
# Must return JSON in the expected index format.
PAPER_INDEX_URL=https://wg21.link/index.json

# Log verbosity for pino.
# Common values: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
